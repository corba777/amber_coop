{
  "compilerOptions": {
    "target": "es2020",
    
    "moduleResolution": "bundler", "module": "esnext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["es2020", "dom"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["shared/**/*", "server/**/*", "client/**/*", "test/**/*"]
}
