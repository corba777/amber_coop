# ===== AMBER COOP configuration =====
# Copy to .env and fill in. Keys never leave the server.
#   cp .env.example .env

PORT=8080

# --- Ollama (DGX at 192.168.78.32) ---
OLLAMA_URL=http://192.168.78.32:11434
OLLAMA_MODEL=qwen3.6:35b

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Agent tuning (35B — slower inference, longer timeouts) ---
PLAN_MS=4000
LLM_TIMEOUT_MS=60000
