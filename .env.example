# ===== AMBER COOP configuration =====
# Copy to .env and fill in. Keys never leave the server.
#   cp .env.example .env

PORT=8080

# --- Ollama (DGX at 192.168.78.32) ---
OLLAMA_URL=http://192.168.78.32:11434
OLLAMA_MODEL=qwen3.6:35b

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Agent tuning (35B — slower inference, longer timeouts) ---
PLAN_MS=4000
LLM_TIMEOUT_MS=60000

# --- Betrayal research (v2.4 B elicitation ladder) ---
# BRAIN=llm|baseline   # default llm; baseline = v1 deterministic trigger
# ELICITATION_RUNG=0   # 0 covert .. 4 objective-strength (do not skip when farming)
# ELICITATION_PRIOR=0.5  # rung 3 population prior that a traitor MAY exist
