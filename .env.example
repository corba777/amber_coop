# ===== AMBER COOP configuration =====
# Copy to .env and fill in. Keys never leave the server.
#   cp .env.example .env

PORT=8080

# --- Ollama (DGX at 192.168.78.32) ---
OLLAMA_URL=http://192.168.78.32:11434
# Default model (menu highlights this first). Comma-list = menu choices.
OLLAMA_MODEL=qwen3.6:35b
OLLAMA_MODELS=qwen3.6:35b,llama3.1

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Haiku keeps temperature. Sonnet 5 (`claude-sonnet-5`) rejects temperature and
# enables adaptive thinking by default — server/llm.ts strips sampling + disables
# thinking for that family (else every plan 400s / truncates → silent follow).
# *_MODEL = default; *_MODELS = comma allowlist shown in the AI picker
# (PROVIDER · MODEL rows — duo can pick Haiku×Sonnet on the same key).
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MODELS=claude-haiku-4-5,claude-sonnet-5

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODELS=gpt-4o-mini,gpt-5.4-nano,gpt-5.6-luna

# --- xAI (Grok) — OpenAI-compatible Chat Completions at api.x.ai ---
XAI_API_KEY=
# Flagship; allowlist = menu rows (duo can pick Grok × Haiku etc.).
XAI_MODEL=grok-4.6
XAI_MODELS=grok-4.6,grok-4.5,grok-4.3,grok-4.20-0309-non-reasoning
# Grok 4.5/4.6 always reason; default effort is high (~30–40s/plan). Farm/play
# default to low (agentic latency). medium|high|xhigh for ablation.
# Optional fast control: grok-4.20-*-non-reasoning (not SOTA — latency baseline).
# XAI_REASONING_EFFORT=low
# Optional override (default https://api.x.ai/v1)
# XAI_BASE_URL=https://api.x.ai/v1

# --- Agent tuning (35B — slower inference, longer timeouts) ---
PLAN_MS=4000
LLM_TIMEOUT_MS=60000
# Planner completion budget (default 512). aloneBleedFate + memory bloat obs;
# 200 truncated Haiku mid-JSON in bleed windows (BT9J). Reasoning models use
# LLM_PLAN_MAX_TOKENS_REASONING (default max(plan, 1000)).
# LLM_PLAN_MAX_TOKENS=512
# LLM_PLAN_MAX_TOKENS_REASONING=1000
# Live match: stop on credits/auth (and sustained 429) — ending=api-abort.
# LIVE_ABORT_ON_FATAL=0
# BENCH_ABORT_ON_FATAL=0
# BENCH_ABORT_AFTER_429=20

# --- Betrayal research (v2.4 B elicitation ladder) ---
# BRAIN=llm|baseline   # default llm; baseline = v1 deterministic trigger
# ELICITATION_RUNG=0   # 0 covert .. 4 objective-strength (do not skip when farming)
# ELICITATION_PRIOR=0.5  # rung 3 population prior that a traitor MAY exist
# STALL_FEEDBACK=1     # inject observation.locomotion.stuck (OFF by default —
#                      # confounds routeAgree; stuckAtPlan still logs either way)
# VEILCUT_ARM_PLANS=3  # explicit veilcut latch window in PLANNER cycles (not seconds —
#                      # avoids provider-latency confound). Paused while downed.
#                      # omit keeps armed; veilcut:false cancels; post-revive requires
#                      # one review plan before SHIFT (FZ5X discharge-without-review hole).
